# 复制为 monitor.env，填写真实地址和凭据；安装 requirements-monitor.txt。
GRAFANA_URL=https://zy_grafana.v668live.com
GRAFANA_USERNAME=dev-api
GRAFANA_PASSWORD=
# 可选：使用服务账号令牌时不需要用户名密码
GRAFANA_TOKEN=
GRAFANA_ORG_ID=1
DASHBOARD_UID=ad6mjfp
PANEL_TITLE=全部

# 填服务根地址，例如 http://127.0.0.1:8901；不要附加 /api
CENTER_URL=http://127.0.0.1:8901
CENTER_USERNAME=
CENTER_PASSWORD=
# 截图中短信资源余额的父业务编码
BUSINESS_CODE=534784

# 必须包含 /hook/ 后面的机器人唯一 ID
LARK_WEBHOOK=https://open.larksuite.com/open-apis/bot/v2/hook/
# 机器人启用签名校验时填写
LARK_SECRET=

POLL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30
# Grafana 查询最近 6 小时，允许四小时更新一次的历史样本。
MAX_SAMPLE_AGE_SECONDS=21600
# MySQL：与告警中心使用同一个库；取代 STATE_DB/SQLite。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sms_billing_monitor
MYSQL_USER=monitoring
MYSQL_PASSWORD=
MYSQL_TIME_ZONE=+08:00
# 使用私有 CA 的 MySQL TLS 连接时填写 CA 文件，自动校验证书和主机名。
MYSQL_SSL_CA=
# 面板带模板变量/计算转换时，填 Query inspector 导出的请求 JSON 文件路径。
# 文件内容为 {"queries": [...]}；from/to 每轮自动更新为最近六小时。
GRAFANA_QUERY_FILE=
